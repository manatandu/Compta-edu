rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPERS ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Personnel enseignant : l'assistant a les mêmes droits que le professeur
    // (décision du 24/09/2026). Miroir de PROF_ROLES dans client/src/lib/permissions.ts.
    function isProf() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'professeur', 'assistant'];
    }

    // Aucun mot de passe dans un profil : le mot de passe vit uniquement dans
    // Firebase Authentication. Création : champ interdit. Modification : on peut
    // retirer un ancien mot de passe (nettoyage), jamais en ajouter ni en changer.
    function sansMotDePasseAjoute() {
      return !request.resource.data.keys().hasAny(['password']) ||
        (resource != null && resource.data.keys().hasAny(['password']) &&
         request.resource.data.password == resource.data.password);
    }

    function ownsResource(field) {
      return isAuth() && request.auth.uid == resource.data[field];
    }

    // ─── ÉQUIPE PÉDAGOGIQUE ─────────────────────────────────────────────────
    // Un assistant est rattaché à un professeur titulaire (champ titulaireId de
    // son profil, posé par l'admin). Le titulaire et ses assistants forment une
    // équipe : chacun peut modifier ou supprimer ce qu'un autre membre a créé.
    // titulaire(uid) = titulaireId du compte, ou le compte lui-même s'il n'en a
    // pas (un professeur est son propre titulaire).
    function titulaire(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('titulaireId', uid);
    }

    // createurId appartient-il à l'équipe de l'appelant ? (lui-même inclus)
    function memeEquipe(createurId) {
      return isAuth() && createurId is string && (
        createurId == request.auth.uid ||
        (createurId.size() > 0 && titulaire(request.auth.uid) == titulaire(createurId))
      );
    }

    function createdBy() {
      return memeEquipe(resource.data.get('createdBy', ''));
    }

    // Vérifie que le document appartient au même admin (isolation admin→enfants)
    function sameAdmin() {
      return isAuth() && request.auth.uid == resource.data.adminId;
    }

    // Cours auxquels l'étudiant courant est inscrit (champ coursIds sur son profil,
    // seule source de vérité déjà utilisée côté interface — Layout, Dashboard).
    // Un compte non-étudiant (prof/admin) n'a pas ce champ : tableau vide, sans
    // incidence puisque isProf() court-circuite toujours avant ce test.
    function studentCoursIds() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coursIds', []);
    }

    // Le cours coursId est-il enseigné par l'appelant (créateur ou admin du cours) ?
    // Utilisé pour isoler la SUPPRESSION de contenus produits par un étudiant
    // (tentatives...) : ces documents n'ont pas de createdBy à eux (ils appartiennent
    // à l'étudiant), donc l'isolation prof passe par le cours auquel ils sont rattachés.
    function ownsCours(coursId) {
      return isAuth() && (
        memeEquipe(get(/databases/$(database)/documents/cours/$(coursId)).data.get('createdBy', '')) ||
        get(/databases/$(database)/documents/cours/$(coursId)).data.adminId == request.auth.uid
      );
    }

    // Même principe qu'ownsCours(), mais en passant par le document créateur
    // (devoir, exercice libre...) d'une collection tierce, pour les documents
    // étudiant qui n'ont ni coursId ni createdBy propre (soumissions, tentatives_el).
    function ownsVia(coll, id) {
      return memeEquipe(get(/databases/$(database)/documents/$(coll)/$(id)).data.get('createdBy', ''));
    }

    // ─── USERS ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Création :
      // 1) Auto-inscription (code d'accès, utilisateur non authentifié) : le compte créé
      //    ne peut être qu'un compte étudiant — jamais un rôle à privilèges.
      // 2) Création d'un compte professeur/assistant/admin par un admin : l'écriture se
      //    fait techniquement "en tant que" le nouveau compte (secondaryAuth), donc on
      //    exige qu'une invitation ait été posée au préalable par un admin authentifié
      //    (voir accountInvites) avant d'accepter un rôle à privilèges.
      // 3) Admin déjà authentifié écrivant directement (cas de repli import CSV / collision
      //    d'e-mail où l'uid généré ne correspond à aucun compte Auth).
      allow create: if !request.resource.data.keys().hasAny(['password']) && ((request.auth.uid == userId && (
        (request.resource.data.role == 'etudiant' && !request.resource.data.keys().hasAny(['titulaireId'])) ||
        (
          request.resource.data.role in ['professeur', 'assistant', 'admin'] &&
          exists(/databases/$(database)/documents/accountInvites/$(userId)) &&
          get(/databases/$(database)/documents/accountInvites/$(userId)).data.role == request.resource.data.role &&
          // Rattachement à un titulaire : uniquement celui fixé par l'admin dans l'invitation.
          request.resource.data.get('titulaireId', null) ==
            get(/databases/$(database)/documents/accountInvites/$(userId)).data.get('titulaireId', null)
        )
      )) || isAdmin());
      // Lecture : utilisateur lui-même OU prof/admin (isProf()). Les écrans de gestion
      // étudiants (ProfesseurPage, DocumentsPage, InscriptionPlatformePage) s'appuient
      // sur une lecture de la collection users entière et sont censés être accessibles
      // aux comptes 'professeur' (voir isProfRole() dans permissions.ts côté client) —
      // avec seulement isAdmin() ici, cette requête de liste échouait entièrement pour
      // un prof non-admin (Firestore rejette une requête non filtrée dès qu'une partie
      // des documents ne satisfait pas la règle), cassant silencieusement ces écrans.
      // isProf() couvre aussi 'assistant' (mêmes droits que le professeur).
      // Un étudiant ne lit jamais le profil complet d'un autre compte : les
      // contacts de sa messagerie passent par la collection annuaire (ci-dessous),
      // qui ne contient que le nom et le rôle. Une condition sur resource.data
      // ne protège pas une requête de liste de façon fiable (testé à l'émulateur).
      allow read: if isAuth() && (request.auth.uid == userId || isProf());
      // Modification : un admin peut tout modifier. Un utilisateur peut modifier SON
      // propre profil mais ne peut PAS changer son propre role/actif/statutInscription
      // (sinon un étudiant s'auto-attribue le rôle admin, ou s'auto-valide son inscription
      // en attente — même faille que sur la création, ici via update).
      allow update: if sansMotDePasseAjoute() && (isAdmin() || (
        isAuth() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('actif', null) == resource.data.get('actif', null) &&
        request.resource.data.get('statutInscription', null) == resource.data.get('statutInscription', null) &&
        // Le rattachement à un titulaire (équipe pédagogique) n'est modifiable que par l'admin.
        request.resource.data.get('titulaireId', null) == resource.data.get('titulaireId', null)
      ));
      allow delete: if isAdmin();
    }

    // ─── ANNUAIRE DU PERSONNEL ────────────────────────────────────────────────
    // Fiche publique minimale (nom, prénom, identifiant, rôle) de chaque membre
    // du personnel, lisible par tout compte connecté : liste de contacts de la
    // messagerie étudiante et noms des expéditeurs dans la cloche. Écrite par le
    // membre lui-même (à la connexion) ou par l'admin ; aucun autre champ admis.
    match /annuaire/{uid} {
      allow read: if isAuth();
      allow create, update: if (
          (request.auth.uid == uid && isProf()) || isAdmin()
        ) &&
        request.resource.data.keys().hasOnly(['nom', 'prenom', 'username', 'role']) &&
        request.resource.data.role in ['admin', 'professeur', 'assistant'] &&
        (isAdmin() || request.resource.data.role == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role);
      allow delete: if isAdmin();
    }

    // ─── INVITATIONS DE COMPTE (rôles à privilèges) ────────────────────────────
    // Posée par un admin, sur sa propre session, juste avant la création d'un compte
    // professeur/assistant/admin via secondaryAuth. Consommée par la règle de création
    // ci-dessus ; jamais utilisée directement par l'interface.
    match /accountInvites/{inviteId} {
      allow read, write: if isAdmin();
    }

    // ─── SESSIONS ────────────────────────────────────────────────────────────
    // Isolation : une session (exercice journal) appartient à un étudiant (userId).
    // Les profs peuvent les lire (statistiques du tableau de bord) mais pas les modifier.
    match /sessions/{sessionId} {
      allow read: if isAuth() && (ownsResource('userId') || isProf());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && ownsResource('userId');
    }

    // ─── ÉCRITURES COMPTABLES ────────────────────────────────────────────────
    match /ecritures/{ecritureId} {
      allow read: if isAuth() && ownsResource('userId');
      allow write: if isAuth() && (
        request.auth.uid == resource.data.userId ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // ─── EXERCICES (cotés — créés par profs/admins) ──────────────────────────
    // Isolation : chaque exercice est lié à un coursId.
    // Un étudiant ne voit que les exercices de SES cours.
    // IMPORTANT : pas de branche "OR coursId absent" ici — testé en pratique,
    // une telle clause rend Firestore incapable de valider correctement une
    // requête de LISTE (list) et la laisse passer même pour un document d'un
    // autre cours (contournement complet de l'isolation). Un exercice sans
    // coursId n'est donc plus lisible par un étudiant via cette règle — seuls
    // les profs/admins (isProf()) y ont accès. C'est un compromis assumé :
    // la sécurité prime sur la visibilité d'un contenu "global" marginal.
    match /exercices/{exerciceId} {
      allow read: if isAuth() && (isProf() || resource.data.coursId in studentCoursIds());
      allow create: if isProf();
      allow update, delete: if isProf() && createdBy();
    }

    // ─── TENTATIVES (réponses aux exercices cotés) ────────────────────────────
    // Isolation : une tentative appartient à un étudiant ET un coursId.
    // Un étudiant ne peut lire/écrire QUE ses propres tentatives.
    // Un prof/admin peut lire toutes les tentatives de ses cours.
    //
    // IMPORTANT — bug corrigé : cette règle vérifiait un champ 'etudiantId' qui
    // n'a jamais existé sur les documents réels. saveTentativeAsync() (db-firebase.ts)
    // et le type Tentative (db.ts) utilisent 'userId' partout — vérifié contre
    // l'émulateur avec la charge utile exacte envoyée par ExerciceDetailPage.tsx :
    // le create échouait systématiquement (PERMISSION_DENIED), en silence
    // (.catch(console.error) côté appelant). Conséquence réelle : aucun étudiant
    // ne pouvait enregistrer une tentative d'exercice coté. Champ corrigé en 'userId'.
    match /tentatives/{tentativeId} {
      allow read: if isAuth() && (
        ownsResource('userId') || isProf()
      );
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuth() && ownsResource('userId');
      // Suppression isolée par cours (et non isProf() global) : un prof ne peut
      // supprimer que les tentatives d'un cours qu'il enseigne ; sans coursId
      // (champ optionnel), seul un admin le peut — même compromis assumé
      // qu'ailleurs dans ce fichier (sécurité > visibilité d'un contenu marginal
      // non rattaché à un cours).
      allow delete: if isProf() && (
        (resource.data.coursId != null && ownsCours(resource.data.coursId)) || isAdmin()
      );
    }

    // ─── EXERCICES LIBRES (entraînement — non cotés) ─────────────────────────
    // Isolation stricte par coursId :
    // • Un exercice libre est rattaché à un coursId (OBLIGATOIRE)
    // • Un étudiant ne voit que les exercices libres de ses cours (coursId dans ses coursIds)
    // • Un prof ne voit que ses propres exercices libres (createdBy)
    match /exercices_libres/{exId} {
      allow read: if isAuth() && (isProf() || resource.data.coursId in studentCoursIds());
      allow create: if isProf() && request.resource.data.keys().hasAll(['coursId', 'createdBy']);
      allow update, delete: if isProf() && createdBy();
    }

    // ─── TENTATIVES EXERCICES LIBRES ──────────────────────────────────────────
    // Isolation : par étudiant. Un étudiant ne peut voir que ses propres tentatives.
    match /tentatives_el/{tentativeId} {
      allow read: if isAuth() && (ownsResource('etudiantId') || isProf());
      allow create: if isAuth() && request.resource.data.etudiantId == request.auth.uid;
      allow update: if isAuth() && ownsResource('etudiantId');
      // Suppression isolée par créateur de l'exercice libre rattaché (et non
      // isProf() global) : un prof ne peut supprimer que les tentatives d'un
      // exercice libre qu'il a lui-même créé.
      allow delete: if isProf() && (
        ownsVia('exercices_libres', resource.data.exerciceId) || isAdmin()
      );
    }

    // ─── DOCUMENTS ───────────────────────────────────────────────────────────
    // Isolation : un document est lié à un promotionId ET/OU un coursId.
    // Un étudiant ne voit que les documents de SA promotion ET de SES cours.
    // Règle :
    //   - Doc sans promotionId et sans coursId → visible par tous (document système global)
    //   - Doc avec promotionId mais sans coursId → visible par toute la promotion
    //   - Doc avec coursId mais sans promotionId → visible pour tout le cours
    //   - Doc avec promotionId ET coursId → visible uniquement pour les étudiants des deux
    // NOTE : le champ promotionId a été retiré du formulaire de création (DocumentsPage) —
    // en pratique seul coursId isole encore les documents créés depuis l'interface actuelle.
    // IMPORTANT : pas de branche "OR coursId absent" ici — testé en pratique,
    // une telle clause rend Firestore incapable de valider correctement une
    // requête de LISTE (list) et la laisse passer même pour un document d'un
    // autre cours (contournement complet de l'isolation). Un document sans
    // coursId n'est donc plus lisible par un étudiant via cette règle — seuls
    // les profs/admins (isProf()) y ont accès.
    match /documents/{documentId} {
      allow read: if isAuth() && (isProf() || resource.data.coursId in studentCoursIds());
      allow create: if isProf() && request.resource.data.keys().hasAll(['createdBy']);
      allow update, delete: if isProf() && createdBy();
    }

    // ─── MESSAGES ────────────────────────────────────────────────────────────
    // Isolation : un message n'est lisible/modifiable que par l'expéditeur ou le
    // destinataire (champ 'participants' = [expediteurId, destinataireId]).
    match /messages/{messageId} {
      allow read, update, delete: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.resource.data.expediteurId == request.auth.uid;
    }

    // ─── CODES D'ACCÈS ─────────────────────────────────────────────────────────
    // Lecture publique MAIS uniquement document par document (get) : un
    // étudiant non connecté doit pouvoir vérifier LE code qu'il a saisi
    // (getDoc par id exact — voir LoginPage/InscriptionPlatformePage), jamais
    // lister TOUTE la collection (list) — sinon n'importe qui pourrait
    // récupérer tous les codes valides d'un coup et s'auto-inscrire dans
    // n'importe quelle promotion sans avoir reçu de code.
    // Écriture réservée aux admins/profs (génération de codes)
    match /codesAcces/{codeId} {
      allow get: if true;
      allow list: if isProf();
      allow write: if isProf();
    }

    // ─── CONFIG (réglages globaux, ex. année académique en cours) ────────────
    // Un seul document utilisé pour l'instant : config/anneeAcademique. Lecture
    // ouverte à tout authentifié (affichage du bandeau année dans plusieurs
    // écrans), écriture réservée aux admins (bascule d'année = archivage de
    // toutes les promotions, action globale et sensible).
    match /config/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── UNIVERSITÉS, FACULTÉS ───────────────────────────────────────────────
    match /universites/{uid} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /facultes/{fid} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ─── COURS ───────────────────────────────────────────────────────────────
    // Isolation admin : chaque administrateur ne voit que SES cours (adminId)
    // et les étudiants inscrits dans CES cours uniquement.
    match /cours/{coursId} {
      allow read: if isAuth();
      allow create: if isProf() && request.resource.data.keys().hasAll(['adminId', 'createdBy']);
      allow update, delete: if isProf() && (createdBy() || isAdmin());
    }

    // ─── COURS_STATUTS (progression étudiant par cours) ──────────────────────
    // id = etudiantId_coursId → isolation naturelle
    match /cours_statuts/{statutId} {
      allow read: if isAuth() && (ownsResource('etudiantId') || isProf());
      allow write: if isAuth() && (
        request.auth.uid == resource.data.etudiantId ||
        request.resource.data.etudiantId == request.auth.uid ||
        isProf()
      );
    }

    // ─── DEVOIRS ─────────────────────────────────────────────────────────────
    // Isolation stricte par coursId :
    // • Un devoir DOIT avoir un coursId (OBLIGATOIRE)
    // • Un étudiant voit uniquement les devoirs de SES cours
    // • Un prof voit uniquement SES devoirs
    match /devoirs/{devoirId} {
      allow read: if isAuth() && (isProf() || resource.data.coursId in studentCoursIds());
      allow create: if isProf() && request.resource.data.keys().hasAll(['coursId', 'createdBy', 'promotionId']);
      allow update, delete: if isProf() && createdBy();
    }

    // ─── SOUMISSIONS (réponses aux devoirs) ──────────────────────────────────
    // Isolation : par étudiant ET par devoir.
    match /soumissions/{soumissionId} {
      allow read: if isAuth() && (ownsResource('etudiantId') || isProf());
      allow create: if isAuth() && request.resource.data.etudiantId == request.auth.uid;
      // Modification :
      // - l'étudiant : jamais les champs de correction (sinon il pouvait
      //   s'attribuer sa propre note) ;
      // - la correction (note, commentaire, statut, date) : l'équipe
      //   pédagogique du créateur du devoir, ou l'admin. Auparavant seul
      //   l'étudiant pouvait modifier sa soumission : la correction par le
      //   professeur était refusée par Firestore.
      allow update: if (
          ownsResource('etudiantId') &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['note', 'commentaire', 'statut', 'dateCorrection'])
        ) || (
          isProf() && (ownsVia('devoirs', resource.data.devoirId) || isAdmin()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'commentaire', 'statut', 'dateCorrection'])
        );
      // Suppression isolée par créateur du devoir rattaché (et non isProf()
      // global) : un prof ne peut supprimer que les soumissions d'un devoir
      // qu'il a lui-même créé.
      allow delete: if isProf() && (
        ownsVia('devoirs', resource.data.devoirId) || isAdmin()
      );
    }

    // ─── PRÉSENCES ───────────────────────────────────────────────────────────
    // Isolation : par coursId et par étudiant.
    //
    // IMPORTANT — bug corrigé : la lecture vérifiait un champ plat 'etudiantId'
    // qui n'existe pas sur les documents réels — le type Presence (db.ts) stocke
    // un tableau d'objets 'etudiants: [{etudiantId, present}]', jamais de champ
    // 'etudiantId' à la racine. onPresencesByEtudiantSnapshot() (db-firebase.ts)
    // faisait donc une écoute NON FILTRÉE sur toute la collection en filtrant
    // côté client — chaque document réel échouait la règle, donc Firestore
    // rejetait l'écoute en bloc. Conséquence réelle : un étudiant ne pouvait lire
    // AUCUNE présence, y compris les siennes (widget d'assiduité du dashboard).
    // Corrigé en ajoutant un champ dérivé 'etudiantIds' (tableau plat, maintenu
    // par createPresenceAsync/updatePresenceAsync) que la règle ET une requête
    // where('etudiantIds','array-contains', uid) peuvent exploiter correctement
    // (Firestore ne sait filtrer/vérifier un tableau d'objets par sous-champ).
    match /presences/{presenceId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.get('etudiantIds', []) || isProf()
      );
      allow create: if isProf() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isProf() && (createdBy() || isAdmin());
    }

    // ─── NOTES DE COURS ──────────────────────────────────────────────────────
    // Isolation DOUBLE par coursId ET promotionId :
    // • Une note de cours DOIT avoir coursId ET promotionId (OBLIGATOIRE)
    // • Un étudiant ne voit que les notes de SES cours ET de SA promotion
    // • Un prof ne voit que SES notes (createdBy)
    // RÈGLE : PAS D'INTERFÉRENCE — les notes d'un cours A ne sont JAMAIS
    //         visibles dans un cours B, même pour la même promotion.
    match /notes_cours/{noteId} {
      allow read: if isAuth() && (isProf() || resource.data.coursId in studentCoursIds());
      allow create: if isProf() && request.resource.data.keys().hasAll(['coursId', 'promotionId', 'createdBy']);
      allow update, delete: if isProf() && createdBy();
    }

    // ─── STOCK (comptabilité de stock personnelle — exercice pédagogique) ────
    // Isolation stricte par userId, comme ecritures/sessions : ces collections
    // n'avaient ICI AUCUNE règle avant ce correctif — Firestore refuse par
    // défaut tout ce qui n'a pas de correspondance dans ce fichier, donc les 6
    // pages Stock (GestionStockPage, StockArticlesPage, StockMouvementPage,
    // StockJournalPage, StockFichePage, StockExercicePage) étaient entièrement
    // inutilisables en production (PERMISSION_DENIED sur toute lecture/écriture).
    // create/update séparés (plutôt qu'un seul "write") pour empêcher un
    // utilisateur de réattribuer userId à quelqu'un d'autre lors d'une
    // modification : update exige à la fois la propriété actuelle ET que la
    // nouvelle valeur reste la sienne.
    match /stock_articles/{articleId} {
      allow read: if isAuth() && ownsResource('userId');
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && ownsResource('userId') && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && ownsResource('userId');
    }

    match /stock_mouvements/{mouvementId} {
      allow read: if isAuth() && ownsResource('userId');
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && ownsResource('userId') && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && ownsResource('userId');
    }

    match /stock_ecritures/{ecritureId} {
      allow read: if isAuth() && ownsResource('userId');
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && ownsResource('userId') && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && ownsResource('userId');
    }

    // ─── EMPRUNTS (Module 7 UE9 — tableau d'amortissement, écritures, écarts) ─
    match /emprunts/{empruntId} {
      allow read: if isAuth() && ownsResource('userId');
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && ownsResource('userId') && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && ownsResource('userId');
    }

    // ─── FACTURES EN DEVISES (Module 5 UE9 — créances/dettes commerciales) ────
    match /factures_devises/{factureId} {
      allow read: if isAuth() && ownsResource('userId');
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && ownsResource('userId') && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && ownsResource('userId');
    }

    // ─── ÉTUDIANTS (fiches administratives — GestionEtudiantsPage) ────────────
    // Registre administratif des étudiants (interne/externe), distinct des
    // comptes de connexion (collection users) : une fiche peut exister sans
    // compte plateforme (userId == null, étudiant externe). Réservé au
    // personnel (isProf() : admin, professeur, assistant — miroir de
    // isStaffRole() côté client dans permissions.ts). AUCUNE règle n'existait ici avant ce correctif :
    // Firestore refuse par défaut tout accès à une collection sans match
    // correspondant, ce qui rendait GestionEtudiantsPage inutilisable en
    // production (toast "Impossible de charger les étudiants").
    match /etudiants/{etudiantId} {
      allow read: if isProf();
      // 1) Formulaire "Nouvel étudiant" : le prof/admin est authentifié sur sa
      //    propre session et écrit directement.
      // 2) Fiche auto-créée par createUserAsync en même temps que le compte
      //    utilisateur (inscription via code d'accès, ou création directe par
      //    un admin) : cette écriture se fait "en tant que" le compte étudiant
      //    tout juste créé (secondaryAuth, voir createUserAsync côté client),
      //    jamais en tant qu'admin. On l'autorise donc uniquement à créer une
      //    fiche qui se désigne elle-même (userId == son propre uid), de type
      //    'interne' — jamais au nom d'un tiers ni de type 'externe'.
      allow create: if (isProf() && request.resource.data.createdBy == request.auth.uid) ||
        (isAuth() && request.resource.data.userId == request.auth.uid && request.resource.data.type == 'interne');
      allow update, delete: if isProf() && (createdBy() || isAdmin());
    }
  }
}
